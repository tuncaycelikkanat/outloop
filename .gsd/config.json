{
  "project": "No More Reels",
  "version": "1.0.0",
  "framework": "GSD Core v1.0",
  "verification": {
    "test_command": "./gradlew testDebugUnitTest",
    "build_command": "./gradlew assembleDebug"
  },
  "constraints": {
    "zero_internet": true,
    "flat_design_elevation_dp": 0,
    "target_sdk": 34
  },
  "loop": {
    "task_queue": ".gsd/tasks.json",
    "progress_log": ".gsd/progress.log",
    "max_retries_per_task": 3
  }
}
